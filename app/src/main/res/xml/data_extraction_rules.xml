<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12 and newer: the same as backup_rules.xml for both cloud backup and
   moving to a new device. Only preferences go; see backup_rules.xml for why.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <include domain="file" path="androidx.appcompat.app.AppCompatDelegate.application_locales_record_file" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="file" path="androidx.appcompat.app.AppCompatDelegate.application_locales_record_file" />
    </device-transfer>
</data-extraction-rules>
