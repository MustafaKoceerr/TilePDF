<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 and older. Only preferences are backed up: reading settings, the
   theme, and the language AppCompat records below Android 13. The library and
   annotation drafts point at files whose read grants don't survive a restore,
   and private PDF copies could push the backup past its 25 MB limit.
-->
<full-backup-content>
    <include domain="file" path="datastore/" />
    <include domain="file" path="androidx.appcompat.app.AppCompatDelegate.application_locales_record_file" />
</full-backup-content>
