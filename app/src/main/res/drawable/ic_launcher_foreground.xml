<?xml version="1.0" encoding="utf-8"?>
<!-- A page with a folded corner; its lower half is a 2x2 grid of tiles, as TilePDF renders pages.
     Scaled to 88% so the page and its shadow stay in the 66 dp safe zone.
     Source: fastlane/design/icon/icon.svg, which the Play Store icon is rendered from. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.88"
        android:scaleY="0.88">
        <!-- Soft shadow -->
        <path
            android:fillAlpha="0.28"
            android:fillColor="#1A1442"
            android:pathData="M36,29h28l12,12v41a4,4 0,0 1,-4 4h-36a4,4 0,0 1,-4 -4v-49a4,4 0,0 1,4 -4z" />
        <!-- Page -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M35,26h28l12,12v41a4,4 0,0 1,-4 4h-36a4,4 0,0 1,-4 -4v-49a4,4 0,0 1,4 -4z" />
        <!-- Folded corner -->
        <path
            android:fillColor="#D9CFF7"
            android:pathData="M63,26v8a4,4 0,0 0,4 4h8z" />
        <!-- Text lines -->
        <path
            android:fillColor="#C4B5EE"
            android:pathData="M38.5,36h18a1.5,1.5 0,0 1,0 3h-18a1.5,1.5 0,0 1,0 -3zM38.5,42.5h28a1.5,1.5 0,0 1,0 3h-28a1.5,1.5 0,0 1,0 -3z" />
        <!-- Tiles -->
        <path android:pathData="M39,50h11a2,2 0,0 1,2 2v9a2,2 0,0 1,-2 2h-11a2,2 0,0 1,-2 -2v-9a2,2 0,0 1,2 -2zM58,67h11a2,2 0,0 1,2 2v9a2,2 0,0 1,-2 2h-11a2,2 0,0 1,-2 -2v-9a2,2 0,0 1,2 -2z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="38"
                    android:startY="49"
                    android:endX="70"
                    android:endY="80">
                    <item android:offset="0" android:color="#FF7C5FD8" />
                    <item android:offset="1" android:color="#FF4B3A9A" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:fillColor="#B3A2EC"
            android:pathData="M58,50h11a2,2 0,0 1,2 2v9a2,2 0,0 1,-2 2h-11a2,2 0,0 1,-2 -2v-9a2,2 0,0 1,2 -2zM39,67h11a2,2 0,0 1,2 2v9a2,2 0,0 1,-2 2h-11a2,2 0,0 1,-2 -2v-9a2,2 0,0 1,2 -2z" />
    </group>
</vector>
